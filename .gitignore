# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binaries
*.test

# Output of the go coverage tool
*.out

# Dependency directories (remove if you use vendoring)
vendor/

# Go workspace files
go.work
go.work.sum

# Build artifacts
bin/
dist/

# Logs
*.log
*.tmp

# OS-specific files
.DS_Store
Thumbs.db

# IDE/editor specific
.vscode/
.idea/
*.swp

# Configs and environment files
.env
.env.local
.env.*

# Docker related
.docker/
docker-compose.override.yml

# Cache
__pycache__/
*.pyc
*.pyo
*.pyd
*.pid
*.seed
*.coverprofile

# Frontend
frontend/node_modules/
frontend/.next/
frontend/out/

temp/

# ─── Agent / AI-generated docs (keep README.md) ──────────
ARCHITECTURE.md
CHANGES_SUMMARY.md
CLAUDE.md
AGENTS.md
INTEGRATION_GUIDE.md
PROJECT_DOCUMENTATION.md

# Catch-all for any other generated markdown (but keep README)
